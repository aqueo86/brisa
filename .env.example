# ========================================================
# BRISA - VARIABLES DE ENTORNO Y CONFIGURACIÓN
# ========================================================

# Inteligencia Artificial Gemini (Detección de recibos y asistente financiero)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Copias de respaldo en Google Drive
GOOGLE_DRIVE_CLIENT_ID=

# ========================================================
# AUTENTICACIÓN MULTI-PROVEEDOR
# ========================================================

# 1. Google Identity / Gmail (Google Cloud Console)
# Obtén tu Web Client ID en: https://console.cloud.google.com/apis/credentials
# Configura como origen autorizado: http://localhost:3000 y tu dominio en producción.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 2. Apple ID / Sign in with Apple (Apple Developer Portal)
# Services ID creado en: https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=

# 3. SMS Gateway (Twilio para despacho real de SMS a celulares)
# Si se configuran, el código de 6 dígitos se envía vía SMS al teléfono del usuario (+57 Colombia u otros).
# Si se dejan en blanco, el sistema opera en modo prueba seguro (código visible en pantalla).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
